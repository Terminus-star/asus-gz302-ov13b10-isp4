+	alg = get_unaligned_le32(d + 0x110);
+	real = isp4sd_exp_af_alg_to_real(alg);		/* patch 0051 */
+	pos = isp4sd_exp_af_real_to_code(real);
 	if (pos == exp_af_last)
 		return;
-	dev_info(dev, "EXP-AF: poc %u: AF state %u, target %u -> motor %d\n",
-		 get_unaligned_le32(meta_info), get_unaligned_le32(d + 0x88), get_unaligned_le32(d + 0x110), pos);
+	dev_info(dev, "EXP-AF: poc %u: AF state %u, target %u -> real %d -> motor %d\n",
+		 get_unaligned_le32(meta_info), get_unaligned_le32(d + 0x88), alg, real, pos);
