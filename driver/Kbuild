# Out-of-tree build of the AMD ISP4 capture driver for the START_STREAM
# buffer-threshold experiment.  Mirrors drivers/media/platform/amd/isp4/Makefile,
# but builds a module unconditionally instead of via CONFIG_VIDEO_AMD_ISP4_CAPTURE.
#
# Built by scripts/build-isp4-threshold.sh against the 7.2.0-1.7-cachyos headers.

obj-m += amd_isp4_capture.o
amd_isp4_capture-objs := isp4.o \
                         isp4_debug.o \
                         isp4_interface.o \
                         isp4_subdev.o \
                         isp4_video.o
