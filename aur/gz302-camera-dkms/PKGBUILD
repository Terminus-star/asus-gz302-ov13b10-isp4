    'isp4_hw_reg.h'
    'isp4_interface.c'
    'isp4_interface.h'
    'isp4_subdev.c'
    'isp4_subdev.h'
    'isp4_video.c'
    'isp4_video.h'
    'Kbuild'
    'ov13b10.c'
)
