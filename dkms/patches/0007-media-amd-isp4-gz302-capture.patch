+
 	for (unsigned int i = 0; i < ISP4IF_MAX_STREAM_BUF_COUNT; i++)
 		isp4if_gpu_mem_free(ispif, &ispif->meta_info_buf[i]);
 }
@@ -172,8 +284,12 @@
 {
 	struct device *dev = ispif->dev;
 
-	ispif->fw_mem_pool = isp4if_gpu_mem_alloc(ispif,
-						  ISP4FW_MEMORY_POOL_SIZE);
