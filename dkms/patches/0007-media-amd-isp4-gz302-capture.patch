+/*
+ * EXPERIMENT (GZ302 bring-up, not for upstream).
+ *
+ * isp_fw_log_print() is normally only called when the response thread handles a response, so
+ * log text the firmware writes after its last response is never read.  This drains the firmware
+ * log ring on demand and reports the ring's own pointers, so "log empty" and "log never read"
+ * can be told apart.  Lines are printed as "EXP-FWLOG: <text>".
+ */
+void isp_fw_log_dump(struct isp4_subdev *isp, const char *when)
+{
+	u32 rd = isp4hw_rreg(isp->mmio, ISP_LOG_RB_RPTR0);
+	u32 wr = isp4hw_rreg(isp->mmio, ISP_LOG_RB_WPTR0);
+
+	exp_info(isp->dev, "EXP-FWLOG[%s]: log ring rd %u wr %u, enable_fw_log %d\n",
+		 when, rd, wr, isp->enable_fw_log);
+	isp_fw_log_print(isp);
+}
 #endif
 
 char *isp4dbg_get_buf_src_str(u32 src)
